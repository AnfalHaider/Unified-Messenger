<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="UnifiedMessenger.Controls.ActivityPatternsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource UmHairlineBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="{StaticResource UmPaddingLg}">
        <Grid RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header + account/range filters. Stacked (title over filters) so the title never gets clipped
                 by the dropdowns in the narrow bento column. -->
            <StackPanel Grid.Row="0" Spacing="10">
                <StackPanel Spacing="2">
                    <TextBlock FontSize="{StaticResource UmFontSizeBodyStrong}" FontWeight="SemiBold" Text="Activity patterns" />
                    <TextBlock
                        FontSize="{StaticResource UmFontSizeBody}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="When your customers message most" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="AccountSelector" AutomationProperties.Name="Filter activity by account" MinWidth="150" SelectionChanged="OnFilterChanged" />
                    <ComboBox x:Name="RangeSelector" AutomationProperties.Name="Date range for activity patterns" MinWidth="130" SelectionChanged="OnFilterChanged">
                        <ComboBoxItem Content="Last 90 days" IsSelected="True" Tag="90" />
                        <ComboBoxItem Content="Last 30 days" Tag="30" />
                        <ComboBoxItem Content="This year" Tag="year" />
                        <ComboBoxItem Content="All time" Tag="all" />
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <!-- Dimension segmented control -->
            <Border
                Grid.Row="1"
                HorizontalAlignment="Left"
                CornerRadius="6"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                Padding="{StaticResource UmPaddingXs}">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleButton x:Name="HourButton" Content="Hour of day" IsChecked="True" Click="OnHourClick" Padding="12,4" CornerRadius="6" />
                    <ToggleButton x:Name="DayButton" Content="Day of week" Click="OnDayClick" Padding="12,4" CornerRadius="6" />
                    <ToggleButton x:Name="MonthButton" Content="Month" Click="OnMonthClick" Padding="12,4" CornerRadius="6" />
                    <ToggleButton x:Name="HeatmapButton" Content="Heat map" Click="OnHeatmapClick" Padding="12,4" CornerRadius="6"
                        ToolTipService.ToolTip="When are you busiest, by weekday and hour — for planning coverage" />
                </StackPanel>
            </Border>

            <!-- Chart: bars + axis labels + per-account legend (built imperatively) -->
            <StackPanel Grid.Row="2" Spacing="6">
                <StackPanel x:Name="ChartArea" Spacing="6">
                    <Grid x:Name="ChartHost" Height="190" />
                    <Grid x:Name="AxisHost" />
                    <ItemsRepeater x:Name="LegendHost" Margin="0,4,0,0">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="14" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>
                <Grid x:Name="HeatmapHost" Visibility="Collapsed" />
            </StackPanel>

            <!-- Insight + week-over-week trend -->
            <StackPanel Grid.Row="3" Spacing="8">
                <Border
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="6"
                    Padding="12,8">
                    <!-- Grid, not a horizontal StackPanel: the latter measures children with infinite width,
                         so this text could never wrap and was clipped by the Border instead. -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" FontSize="{StaticResource UmIconSizeMd}" Foreground="{ThemeResource SystemFillColorCautionBrush}" Glyph="&#xEA80;" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="InsightText" FontSize="{StaticResource UmFontSizeBodyStrong}" VerticalAlignment="Center" TextWrapping="WrapWholeWords" />
                    </Grid>
                </Border>
                <Grid x:Name="WeekRow" ColumnSpacing="8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" FontSize="{StaticResource UmIconSizeMd}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE9D2;" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="WeekText" FontSize="{StaticResource UmFontSizeBody}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="WrapWholeWords" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
