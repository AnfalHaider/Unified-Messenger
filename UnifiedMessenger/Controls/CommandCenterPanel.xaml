<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="UnifiedMessenger.Controls.CommandCenterPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:UnifiedMessenger.ViewModels"
    xmlns:shared="using:UnifiedMessenger.Controls.Shared"
    mc:Ignorable="d"
    IsTabStop="False"
    PreviewKeyDown="OnTriageKeyDown">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0 — title + primary actions -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Command center" />
                <TextBlock
                    x:Name="SubtitleText"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="UpdatedText"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Visibility="Collapsed" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center">
                <CalendarDatePicker
                    x:Name="FromDatePicker"
                    MinWidth="130"
                    DateChanged="OnCustomDateChanged"
                    PlaceholderText="From"
                    Visibility="Collapsed" />
                <CalendarDatePicker
                    x:Name="ToDatePicker"
                    MinWidth="130"
                    DateChanged="OnCustomDateChanged"
                    PlaceholderText="To"
                    Visibility="Collapsed" />
                <!--
                    These toolbar controls put a StackPanel (icon + label) or a bare FontIcon in Content,
                    so WinUI derives no accessible name from them and a screen reader announced only
                    "button". Every one needs an explicit AutomationProperties.Name. Re-sync matters most:
                    it is the recovery action the product's own copy tells people to click.
                -->
                <!--
                    Visibly labelled "Metrics". Unlabelled and sitting at the top right next to Re-sync, a
                    combo reading "Today" looks like a filter over the whole page — and now that the
                    Needs-reply list has its own age chips there are two time controls on screen with
                    different scopes. The accessible name always said which was which; sighted users had
                    nothing to go on.
                -->
                <TextBlock
                    Text="Metrics"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ComboBox
                    x:Name="WindowSelector"
                    AutomationProperties.Name="Date range for the metric tiles"
                    MinWidth="120"
                    SelectionChanged="OnWindowChanged"
                    ToolTipService.ToolTip="Scopes the metric tiles only — the Needs-reply list has its own age filter">
                    <ComboBoxItem Content="Today" IsSelected="True" Tag="Today" />
                    <ComboBoxItem Content="Last 7 days" Tag="Week" />
                    <ComboBoxItem Content="All time" Tag="All" />
                    <ComboBoxItem Content="Custom range" Tag="Custom" />
                </ComboBox>
                <!--
                    The Report button used to live here, beside Re-sync. Removed: the sidebar already has a
                    Reports destination, and ReportReminderBanner below offers the report at the moment it
                    is actually worth opening. A toolbar should hold the actions unique to THIS view —
                    Re-sync is one, duplicate navigation is not.
                -->
                <Button
                    x:Name="ResyncButton"
                    AutomationProperties.Name="Re-sync now"
                    Click="OnResyncClick"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Re-read history, refresh the numbers, the activity graph, and Google reviews">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE895;" />
                        <TextBlock Text="Re-sync" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Row 1 — hero status + at-a-glance KPI summary band (responsive, wraps) + AI shift briefing -->
        <StackPanel Grid.Row="1" Spacing="10">
        <!-- Hero: the single answer ("you're caught up" / "N waiting"). Built imperatively in RenderHero. -->
        <Border
            x:Name="HeroCard"
            CornerRadius="14"
            Padding="20,16"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Visibility="Collapsed" />
        <ItemsRepeater x:Name="KpiBand">
            <ItemsRepeater.Layout>
                <UniformGridLayout
                    MinItemWidth="158"
                    MinColumnSpacing="12"
                    MinRowSpacing="12"
                    ItemsStretch="Fill" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:KpiTileViewModel">
                    <!--
                        A Button, not a Border. This was a Border with a Tapped handler, which meant the
                        tiles were MOUSE-ONLY: a Border is not focusable and exposes no Invoke pattern, so a
                        UI Automation capture of the running app showed each tile as bare Text with no
                        accessible name and no way to activate it. Since the tiles are the click-through
                        into the needs-reply list, an entire navigation path was unreachable by keyboard and
                        invisible to a screen reader.

                        The chrome is neutralised to keep the card look, but the semantics are now a real
                        button: tab stop, Enter/Space, Invoke pattern, and an accessible name composed from
                        the tile's own text (see BuildKpiTileName).
                    -->
                    <Button
                        AutomationProperties.Name="{x:Bind AccessibleName}"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,10"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Top"
                        IsTabStop="{x:Bind IsActionable}"
                        Click="OnKpiTileTapped"
                        Tag="{x:Bind ActionKey}"
                        ToolTipService.ToolTip="{x:Bind Tooltip}">
                        <StackPanel Spacing="1">
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Label}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock FontSize="{x:Bind ValueFontSize}" FontWeight="SemiBold" Text="{x:Bind Value}" Foreground="{x:Bind ValueBrush}" />
                                <TextBlock
                                    FontSize="11"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,5"
                                    Text="{x:Bind Delta}"
                                    Foreground="{x:Bind DeltaBrush}"
                                    Visibility="{x:Bind DeltaVisibility}" />
                            </StackPanel>
                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Hint}" TextWrapping="WrapWholeWords" />
                            <shared:MiniSparkline Margin="0,3,0,0" Values="{x:Bind Trend}" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <Border
            x:Name="BriefingStrip"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            CornerRadius="10"
            Padding="12,9"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                    x:Name="BriefingBadge"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Text="✦"
                    VerticalAlignment="Top"
                    Margin="0,1,0,0" />
                <TextBlock x:Name="BriefingText" FontSize="13" TextWrapping="WrapWholeWords" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        </StackPanel>

        <!-- Row 2 — mode segmented control + filter + density -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!--
                Two axes, two controls. These were three toggles inside one bordered group, which read as a
                single three-way choice — but "By account" and "By location" change how the SAME view is
                grouped, while "Needs reply" replaces the view entirely. Presenting the third as a peer of
                the first two made it look like a grouping option.

                The grouping control is hidden while Needs reply is active, because grouping does not apply
                to a flat cross-account queue: offering a control that does nothing is worse than not
                offering it.
            -->
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border
                    CornerRadius="6"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="2"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <ToggleButton
                            x:Name="OverviewViewButton"
                            Content="Overview"
                            IsChecked="True"
                            Click="OnOverviewViewClick"
                            Padding="10,4"
                            CornerRadius="4"
                            ToolTipService.ToolTip="Per-account health cards" />
                        <ToggleButton
                            x:Name="NeedsReplyButton"
                            Content="Needs reply"
                            IsChecked="False"
                            Click="OnNeedsReplyClick"
                            Padding="10,4"
                            CornerRadius="4"
                            ToolTipService.ToolTip="Every customer awaiting a reply across all accounts, most urgent first" />
                    </StackPanel>
                </Border>
                <StackPanel
                    x:Name="GroupingControl"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="Group"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border
                        CornerRadius="6"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Padding="2"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <ToggleButton
                                x:Name="GroupByAccountButton"
                                Content="By account"
                                IsChecked="True"
                                Click="OnGroupByAccountClick"
                                Padding="10,4"
                                CornerRadius="4" />
                            <ToggleButton
                                x:Name="GroupByLocationButton"
                                Content="By location"
                                IsChecked="False"
                                Click="OnGroupByLocationClick"
                                Padding="10,4"
                                CornerRadius="4" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
            <!-- PlaceholderText is not an accessible name; screen readers do not substitute it. -->
            <AutoSuggestBox
                x:Name="SearchBox"
                AutomationProperties.Name="Filter accounts or locations"
                Grid.Column="1"
                MaxWidth="280"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                PlaceholderText="Filter accounts or locations…"
                QueryIcon="Find"
                TextChanged="OnSearchChanged" />
            <ToggleButton
                x:Name="DensityToggle"
                AutomationProperties.Name="Compact view"
                Grid.Column="2"
                Click="OnDensityToggled"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="Compact view — denser rows for many accounts">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xE8A4;" />
                    <TextBlock Text="Compact" />
                </StackPanel>
            </ToggleButton>
        </Grid>

        <!-- Row 3 — define-locations CTA -->
        <Border
            x:Name="LocationCtaBanner"
            Grid.Row="3"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,10"
            Visibility="Collapsed">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE707;" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="13">
                    <Run>Group accounts into&#160;</Run><Run FontWeight="SemiBold">locations</Run><Run>&#160;to oversee a whole branch at once.</Run>
                </TextBlock>
                <Button
                    x:Name="DefineLocationsButton"
                    Grid.Column="2"
                    Content="Define locations ↗"
                    Click="OnDefineLocations"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Row 4 — informational digest (since you were last here); neutral info styling, dismissible -->
        <Border
            x:Name="DigestBanner"
            Grid.Row="4"
            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
            CornerRadius="8"
            Padding="12,9"
            Visibility="Collapsed">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                    Glyph="&#xE946;" />
                <TextBlock
                    x:Name="DigestText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    TextWrapping="WrapWholeWords" />
                <Button
                    x:Name="DigestDismiss"
                    AutomationProperties.Name="Dismiss this summary"
                    Grid.Column="2"
                    Click="OnDismissDigest"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="6"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Dismiss">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </Grid>
        </Border>

        <!-- Row 5 — attention banner (caution): real backlog needing action -->
        <Border
            x:Name="AttentionBanner"
            Grid.Row="5"
            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
            CornerRadius="8"
            Padding="12,10"
            Visibility="Collapsed">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        x:Name="AttentionIcon"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Glyph="&#xE7BA;" />
                    <TextBlock x:Name="AttentionText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="WrapWholeWords" />
                    <Button
                        x:Name="AttentionJumpButton"
                        Grid.Column="2"
                        Content="Jump"
                        Click="OnAttentionJump"
                        Visibility="Collapsed"
                        VerticalAlignment="Center" />
                </Grid>
                <!-- Re-sync progress: determinate bar anchored to per-account completion, eased between anchors. -->
                <Grid x:Name="ResyncProgressRow" ColumnSpacing="10" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar
                        x:Name="ResyncProgressBar"
                        Grid.Column="0"
                        Minimum="0"
                        Maximum="1"
                        VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="ResyncProgressPercent"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        MinWidth="40"
                        TextAlignment="Right"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Row 6 — weekly-report reminder (once a week; opening the report resets it) -->
        <Border
            x:Name="ReportReminderBanner"
            Grid.Row="6"
            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
            CornerRadius="8"
            Padding="12,9"
            Visibility="Collapsed">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                    Glyph="&#xE9D9;" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    TextWrapping="WrapWholeWords"
                    Text="Your weekly business report is ready to review." />
                <Button
                    Grid.Column="2"
                    Content="View report"
                    Click="OnReportClick"
                    VerticalAlignment="Center" />
                <Button
                    Grid.Column="3"
                    AutomationProperties.Name="Dismiss report reminder until next week"
                    Click="OnDismissReportReminder"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="6"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Dismiss until next week">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </Grid>
        </Border>

        <!--
            Confirmation for actions with no other visible result. Copying to the clipboard and handing a
            number to the dialler both succeed silently, and an action with no feedback is one the owner
            repeats because they cannot tell whether it worked. Also announced to assistive tech, since the
            owner driving the queue from the keyboard is usually looking at the chat window, not at this.
        -->
        <Border
            x:Name="TriageToast"
            Grid.Row="7"
            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
            CornerRadius="8"
            Padding="12,8"
            Margin="0,0,0,4"
            HorizontalAlignment="Left"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon
                    FontSize="14"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Glyph="&#xE73E;"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="TriageToastText"
                    FontSize="13"
                    VerticalAlignment="Center"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Border>

        <StackPanel x:Name="CardsHost" Grid.Row="8" Spacing="8">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="14" IsStaggeringEnabled="True" />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
        </StackPanel>

        <!-- Row 7 — status legend: how to read the cards (shown only when cards are visible) -->
        <StackPanel
            x:Name="LegendRow"
            Grid.Row="9"
            Orientation="Horizontal"
            Spacing="14"
            Margin="2,0,0,0"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <FontIcon FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" />
                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="90%+ on track" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
                <FontIcon FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" Glyph="&#xE7BA;" />
                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="70–89% needs attention" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5">
                <FontIcon FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xEA39;" />
                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="below 70% behind" />
            </StackPanel>
            <TextBlock
                FontSize="11"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="% = share of active chats with no customer message waiting" />
        </StackPanel>
    </Grid>
</UserControl>
