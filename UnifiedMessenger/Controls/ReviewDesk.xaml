<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="UnifiedMessenger.Controls.ReviewDesk"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- The whole Reviews surface, laid out to docs/design/review-desk-spec.md.
         Everything with live numbers is built in code-behind, because the values decide the shape: the
         critical strip only exists when there IS a one-star, and a KPI whose data we cannot compute yet has
         to say so rather than render a plausible figure. -->
    <StackPanel Spacing="14">

        <!-- HEADER -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock
                    FontSize="{StaticResource UmFontSizeTitle}"
                    FontWeight="SemiBold"
                    Text="Reviews" />
                <TextBlock
                    x:Name="HeaderSub"
                    FontSize="{StaticResource UmFontSizeCaption}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
            <Button
                x:Name="CheckNowButton"
                Grid.Column="1"
                VerticalAlignment="Top"
                Style="{StaticResource AccentButtonStyle}"
                Content="Check now" />
        </Grid>

        <!-- HERO — rating, trend, needs-a-reply -->
        <Border
            Background="{ThemeResource UmSurfaceBrush}"
            BorderBrush="{ThemeResource UmHairlineBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="{StaticResource UmPaddingLg}">
            <Grid x:Name="HeroHost">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
            </Grid>
        </Border>

        <!-- CRITICAL STRIP — present only when an unhappy review is waiting -->
        <Border
            x:Name="AlertStrip"
            Background="{ThemeResource UmStatusDangerWashBrush}"
            BorderBrush="{ThemeResource UmStatusDangerBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="{StaticResource UmPaddingMd}"
            Visibility="Collapsed" />

        <!-- KPI STRIP — columns are added in code so the tile count can change without touching markup. -->
        <Grid x:Name="KpiHost" ColumnSpacing="9" />

        <!-- TOOLS — filters + keyboard hint -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="FilterHost" Orientation="Horizontal" Spacing="6" />
            <TextBlock
                x:Name="KeyboardHint"
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="{StaticResource UmFontSizeCaption}"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="↑ ↓ move · Enter open · Home / End jump" />
        </Grid>

        <!-- QUEUE -->
        <StackPanel
            x:Name="QueueHost"
            AutomationProperties.Name="Review queue. Use the up and down arrow keys to move through it, Enter to open a review in Google."
            IsTabStop="True"
            UseSystemFocusVisuals="True"
            Spacing="8" />

        <!-- BY BRANCH -->
        <Border
            x:Name="BranchPanel"
            Background="{ThemeResource UmSurfaceBrush}"
            BorderBrush="{ThemeResource UmHairlineBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="{StaticResource UmPaddingLg}"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
