<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="UnifiedMessenger.Dialogs.AddInstanceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Primary"
    PrimaryButtonText="Add"
    SecondaryButtonText="Cancel"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    Title="Add account"
    AutomationProperties.Name="Add account">

    <StackPanel MinWidth="360" Spacing="12" TabFocusNavigation="Cycle">
        <ComboBox
            x:Name="RestoreBox"
            Header="Restore removed account (optional)"
            HorizontalAlignment="Stretch"
            DisplayMemberPath="DisplayName"
            SelectionChanged="RestoreBox_SelectionChanged"
            Visibility="Collapsed" />

        <TextBox
            x:Name="DisplayNameBox"
            Header="Display name"
            PlaceholderText="e.g. WhatsApp Work" />

        <StackPanel Spacing="4">
            <ComboBox
                x:Name="PlatformBox"
                Header="Platform"
                HorizontalAlignment="Stretch"
                SelectionChanged="PlatformBox_SelectionChanged" />

            <!--
                What the selected channel actually gives you. Without this, the picker showed six channels
                as if they were equivalent when only three produce oversight data, so adding Messenger or
                Discord looked broken rather than out of scope.
            -->
            <TextBlock
                x:Name="PlatformCapabilityText"
                FontSize="{StaticResource UmFontSizeBody}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <ComboBox
            x:Name="CategoryBox"
            Header="Workspace"
            HorizontalAlignment="Stretch"
            SelectionChanged="CategoryBox_SelectionChanged" />

        <TextBox
            x:Name="CustomUrlBox"
            Header="Website URL"
            PlaceholderText="https://example.com"
            Visibility="Collapsed" />

        <TextBlock
            x:Name="ValidationMessage"
            Foreground="{ThemeResource UmStatusDangerBrush}"
            TextWrapping="WrapWholeWords"
            Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
