<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="UnifiedMessenger.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:UnifiedMessenger.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:UnifiedMessenger"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Unified Messenger"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Unified Messenger"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <ComboBox
                        x:Name="ScopeSelector"
                        MinWidth="128"
                        AutomationProperties.Name="Account scope"
                        SelectionChanged="ScopeSelector_SelectionChanged"
                        ToolTipService.ToolTip="Filter accounts by scope"
                        Visibility="Collapsed">
                        <ComboBoxItem Content="All accounts" Tag="All" />
                        <ComboBoxItem Content="Professional" Tag="Professional" />
                        <ComboBoxItem Content="Personal" Tag="Personal" />
                    </ComboBox>
                    <ToggleButton
                        x:Name="AiToggleButton"
                        Style="{StaticResource UmChromeToggleStyle}"
                        AutomationProperties.Name="Toggle on-device AI insights"
                        Click="AiToggleButton_Click"
                        ToolTipService.ToolTip="On-device AI insights (Ollama). Falls back to heuristics when off or unavailable.">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="{StaticResource UmIconSizeMd}" Glyph="&#xE945;" />
                            <TextBlock Text="AI" />
                        </StackPanel>
                    </ToggleButton>
                    <!-- Icon-only content carries no accessible name of its own; state it explicitly. -->
                    <Button
                        x:Name="PanePinButton"
                        AutomationProperties.Name="Pin sidebar expanded"
                        Click="PanePinButton_Click"
                        ToolTipService.ToolTip="Pin sidebar expanded">
                        <FontIcon x:Name="PanePinIcon" Glyph="&#xE718;" />
                    </Button>
                    <Button
                        x:Name="NotificationToggleButton"
                        AutomationProperties.AutomationId="ShellNotificationToggle"
                        AutomationProperties.Name="Toggle notification panel"
                        Click="NotificationToggleButton_Click"
                        ToolTipService.ToolTip="Toggle notification panel">
                        <FontIcon Glyph="&#xEA8F;" />
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <Grid Grid.Row="1" x:Name="ShellLayoutGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="NotificationColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="NotificationRow" Height="0" />
            </Grid.RowDefinitions>

            <Border
                x:Name="SidebarHost"
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{ThemeResource UmSurfaceBrush}"
                BorderBrush="{ThemeResource UmHairlineBrush}"
                BorderThickness="0,0,1,0"
                PointerEntered="SidebarHost_PointerEntered"
                PointerExited="SidebarHost_PointerExited">
                <controls:WorkspaceSidebar x:Name="WorkspaceSidebar" />
            </Border>

            <Grid Grid.Row="0" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Instance top bar — a docked "Back to dashboard" for EVERY open account, plus a browser
                     toolbar (NavControlsPanel) for embedded / custom-URL tabs. Docked (not overlaid) so it
                     never covers the page. Wired to the active WebView in MainWindow.xaml.cs. -->
                <Border
                    x:Name="WebNavBar"
                    Grid.Row="0"
                    Padding="{StaticResource UmPaddingSm}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <HyperlinkButton
                            x:Name="BackToDashboardButton"
                            Click="BackToDashboardButton_Click"
                            AutomationProperties.Name="Back to dashboard"
                            ToolTipService.ToolTip="Back to dashboard">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="{StaticResource UmIconSizeSm}" Glyph="&#xE72B;" />
                                <TextBlock Text="Dashboard" />
                            </StackPanel>
                        </HyperlinkButton>

                        <StackPanel x:Name="NavControlsPanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Border Width="1" Height="22" Margin="4,0,4,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Button x:Name="NavBackButton" Click="NavBackButton_Click" Style="{StaticResource SubtleButtonStyle}" Padding="{StaticResource UmPaddingSm}" AutomationProperties.Name="Back" ToolTipService.ToolTip="Back">
                                <FontIcon FontSize="{StaticResource UmIconSizeMd}" Glyph="&#xE72B;" />
                            </Button>
                            <Button x:Name="NavForwardButton" Click="NavForwardButton_Click" Style="{StaticResource SubtleButtonStyle}" Padding="{StaticResource UmPaddingSm}" AutomationProperties.Name="Forward" ToolTipService.ToolTip="Forward">
                                <FontIcon FontSize="{StaticResource UmIconSizeMd}" Glyph="&#xE72A;" />
                            </Button>
                            <Button x:Name="NavReloadButton" Click="NavReloadButton_Click" Style="{StaticResource SubtleButtonStyle}" Padding="{StaticResource UmPaddingSm}" AutomationProperties.Name="Reload" ToolTipService.ToolTip="Reload">
                                <FontIcon FontSize="{StaticResource UmIconSizeMd}" Glyph="&#xE72C;" />
                            </Button>
                            <Button x:Name="NavHomeButton" Click="NavHomeButton_Click" Style="{StaticResource SubtleButtonStyle}" Padding="{StaticResource UmPaddingSm}" AutomationProperties.Name="Home" ToolTipService.ToolTip="Home — back to this account's start page">
                                <FontIcon FontSize="{StaticResource UmIconSizeMd}" Glyph="&#xE80F;" />
                            </Button>
                            <!-- Address: read-only for platform tabs (their session is pinned to that
                                 service by the nav guard), editable for Custom URL tabs so the owner can
                                 actually browse and then save where they landed. -->
                            <Border
                                Margin="4,0,0,0"
                                Padding="12,0"
                                Height="32"
                                MinWidth="220"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <FontIcon FontSize="{StaticResource UmIconSizeSm}" Glyph="&#xE72E;" Foreground="{ThemeResource UmStatusSuccessBrush}" />
                                    <TextBlock x:Name="NavAddressText" VerticalAlignment="Center" FontSize="{StaticResource UmFontSizeBody}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox
                                        x:Name="NavAddressBox"
                                        MinWidth="220"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource UmFontSizeBody}"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Padding="0"
                                        Visibility="Collapsed"
                                        KeyDown="NavAddressBox_KeyDown"
                                        PlaceholderText="Type a web address and press Enter"
                                        AutomationProperties.Name="Web address" />
                                </StackPanel>
                            </Border>

                            <Button
                                x:Name="NavSaveSiteButton"
                                Click="NavSaveSiteButton_Click"
                                Style="{StaticResource SubtleButtonStyle}"
                                Padding="{StaticResource UmPaddingSm}"
                                Visibility="Collapsed"
                                AutomationProperties.Name="Save this site as an account"
                                ToolTipService.ToolTip="Save this site — adds the page you're on as its own account in the sidebar">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="{StaticResource UmIconSizeMd}" Glyph="&#xE74E;" />
                                    <TextBlock FontSize="{StaticResource UmFontSizeBody}" Text="Save site" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                <Grid x:Name="InstanceWebViewHost" />

                <StackPanel
                    x:Name="InstanceLoadingPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="Collapsed">
                    <ProgressRing
                        x:Name="InstanceLoadingRing"
                        Width="40"
                        Height="40"
                        Foreground="{StaticResource UmBrandBlueBrush}"
                        IsActive="True" />
                    <ProgressBar
                        x:Name="StartupWarmProgressBar"
                        Width="280"
                        Maximum="1"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="InstanceLoadingText"
                        HorizontalAlignment="Center"
                        Opacity="0.8"
                        Text="Loading account…" />
                </StackPanel>

                <!-- Opaque, on purpose. This Frame used to have no Background at all, so MicaBackdrop
                     showed through it and every dashboard number sat on a tint sampled from whatever the
                     owner's desktop wallpaper happens to be. Mica belongs on chrome, not under data:
                     it made contrast unpredictable per machine and put a saturated colour behind the
                     whole command center. -->
                <Frame
                    x:Name="ContentFrame"
                    Background="{ThemeResource UmCanvasBrush}"
                    Visibility="Collapsed" />
                </Grid>
            </Grid>

            <controls:NotificationFeedPanel
                x:Name="NotificationPanel"
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="2"
                Visibility="Collapsed" />

        </Grid>

        <controls:CommandPalette
            x:Name="CommandPaletteOverlay"
            Grid.RowSpan="2"
            ItemSelected="CommandPaletteOverlay_ItemSelected" />
    </Grid>
</Window>
