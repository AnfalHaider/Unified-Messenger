<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="UnifiedMessenger.Pages.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:shared="using:UnifiedMessenger.Controls.Shared"
    xmlns:local="using:UnifiedMessenger.Pages">

    <Grid>
    <!-- A fresh install opening Reports was told "Nothing notable in this period — activity looks steady",
         which is the report generator's genuine no-anomalies message being asked a question it cannot
         answer. No account has ever been connected; there is no period and no activity to be steady. -->
    <shared:EmptyStateView
        x:Name="NoAccountsState"
        IconGlyph="&#xE9F9;"
        Title="No accounts connected yet"
        Hint="Reports summarise how your connected accounts performed over a period. Add one and your first report builds once it has a day of activity."
        VerticalAlignment="Center"
        Visibility="Collapsed">
        <shared:EmptyStateView.ActionContent>
            <Button x:Name="AddAccountFromReportsButton" Click="AddAccountButton_Click" Content="Add account" />
        </shared:EmptyStateView.ActionContent>
    </shared:EmptyStateView>

    <ScrollViewer x:Name="ReportsContent" Padding="{StaticResource UmPaddingXl}" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Spacing="16" HorizontalAlignment="Stretch" MaxWidth="900">
            <StackPanel Spacing="2">
                <TextBlock Text="Reports" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    FontSize="{StaticResource UmFontSizeBodyStrong}"
                    Opacity="0.7"
                    Text="A plain-language business report with anomaly detection, for any recent period."
                    TextWrapping="WrapWholeWords" />
                <!-- Same stamp as Analytics: a report built from a stale scrape must say so. -->
                <TextBlock
                    x:Name="FreshnessText"
                    FontSize="{StaticResource UmFontSizeCaption}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock
                    Text="Period"
                    FontSize="{StaticResource UmFontSizeBody}"
                    Opacity="0.7"
                    VerticalAlignment="Center" />
                <ComboBox x:Name="RangeBox" AutomationProperties.Name="Reporting period" MinWidth="180" SelectionChanged="RangeBox_SelectionChanged" />
                <Button x:Name="SaveMarkdownButton" Click="SaveMarkdownButton_Click" Content="Save report (.md)" />
                <Button x:Name="ExportCsvButton" Click="ExportCsvButton_Click" Content="Export data (.csv)" />
            </StackPanel>

            <Border
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                CornerRadius="8"
                Padding="{StaticResource UmPaddingLg}">
                <StackPanel x:Name="ReportBody" Spacing="10" />
            </Border>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
