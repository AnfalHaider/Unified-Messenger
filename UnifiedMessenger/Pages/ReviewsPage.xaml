<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="UnifiedMessenger.Pages.ReviewsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:UnifiedMessenger.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:local="using:UnifiedMessenger.Pages">

    <ScrollViewer Padding="{StaticResource UmPaddingXl}" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <Grid>
            <!-- The desk owns the whole surface, including its own header and refresh. It used to sit above
                 the old ReviewHealthPanel, which meant the page showed a queue and then repeated the same figures as
                 per-account cards underneath. -->
            <controls:ReviewDesk x:Name="ReviewDesk" />

            <!-- The desk states "no Google Business account is connected" inside its queue area, but with no
                 account there are also no numbers above it, so the page needs its own answer for that case. -->
            <StackPanel
                x:Name="NoAccountsState"
                Spacing="8"
                Padding="{StaticResource UmPaddingXl}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Visibility="Collapsed">
                <FontIcon FontSize="{StaticResource UmIconSizeLg}" Glyph="&#xE734;" HorizontalAlignment="Center" Opacity="0.55" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="No Google Business account connected" />
                <TextBlock
                    HorizontalAlignment="Center"
                    MaxWidth="420"
                    Opacity="0.7"
                    TextAlignment="Center"
                    TextWrapping="WrapWholeWords"
                    Text="Add a Google Business account to track your rating, reply rate, and which reviews still need a response." />
                <!-- The state told the owner what to do and then gave them no way to do it — a dead end
                     on the one screen a new install is most likely to open first. -->
                <Button
                    x:Name="AddAccountFromReviewsButton"
                    HorizontalAlignment="Center"
                    Margin="0,4,0,0"
                    Click="AddAccountButton_Click"
                    Content="Add account" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
