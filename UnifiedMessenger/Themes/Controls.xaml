<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="DashboardMetricCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource UmHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource UmCornerRadiusMdValue}" />
    </Style>

    <Style x:Key="DashboardCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource UmPaddingMd}" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource UmHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource UmCornerRadiusMdValue}" />
    </Style>

    <Style x:Key="UmSurfaceCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource UmPaddingLg}" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource UmHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource UmCornerRadiusMdValue}" />
    </Style>

    <Style x:Key="SubtleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource UmCornerRadiusMdValue}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <!--
        Segmented control: a recessed track with a RAISED selected segment.

        It previously used a stock ToggleButton, whose checked state fills with the Windows accent colour.
        On this owner's machine that is a brick red, so "Overview" and "By account" rendered as filled red
        badges — indistinguishable from a warning, and the loudest thing on a dashboard whose actual alerts
        are also red. Overriding the accent brushes did not reach it: WinUI resolves the control's own
        `ToggleButtonBackgroundChecked` from inside XamlControlsResources, and app-level redeclarations are
        shadowed (tried twice — the toggles stayed red both times).

        So the state is drawn here instead, from the surface tokens. Selection now reads as elevation —
        the selected segment sits on the card surface while the track behind it is sunken — which is what
        a segmented control is supposed to look like, and it cannot be repainted by a system setting.
    -->
    <Style x:Key="UmSegmentedToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="CornerRadius" Value="{StaticResource UmCornerRadiusSmValue}" />
        <Setter Property="FontSize" Value="{StaticResource UmFontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource UmHairlineBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource UmHairlineStrongBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Label.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource UmSurfaceBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource UmHairlineBrush}" />
                                        <Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource UmSurfaceBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource UmHairlineStrongBrush}" />
                                        <Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource UmSurfaceSunkenBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource UmHairlineStrongBrush}" />
                                        <Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource UmSurfaceBrush}" />
                                        <Setter Target="Label.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="Label"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A chrome toggle (the title bar's AI switch). Same reasoning as the segmented control: its "on"
        state was a solid fill in the Windows accent, which on this machine is a dark red — so the app's
        title bar carried a permanent red badge that looked like a warning about the AI feature rather than
        an indication it was enabled. On reads as a tinted, accented state instead.
    -->
    <Style x:Key="UmChromeToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="CornerRadius" Value="{StaticResource UmCornerRadiusSmValue}" />
        <Setter Property="FontSize" Value="{StaticResource UmFontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource UmSurfaceSunkenBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource UmHairlineBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Label.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource UmAccentWashBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource UmBrandTealBrush}" />
                                        <Setter Target="Label.Foreground" Value="{ThemeResource UmBrandTealBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource UmAccentWashBrush}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource UmBrandTealBrush}" />
                                        <Setter Target="Label.Foreground" Value="{ThemeResource UmBrandTealBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource UmHairlineBrush}" />
                                        <Setter Target="Label.Foreground" Value="{ThemeResource UmBrandTealBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Label.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            x:Name="Label"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The track the segments sit in: sunken, so the selected segment reads as raised out of it. -->
    <Style x:Key="UmSegmentedTrackStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource UmSurfaceSunkenBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource UmHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource UmCornerRadiusMdValue}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource UmBrandTealBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource UmCornerRadiusMdValue}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="KanbanColumnDropZoneStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="{StaticResource UmKanbanColumnMinHeight}" />
        <Setter Property="Padding" Value="{StaticResource UmPaddingKanbanColumn}" />
        <Setter Property="BorderBrush" Value="{ThemeResource UmHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource UmCornerRadiusSmValue}" />
    </Style>

    <Style x:Key="UmTagBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource UmPaddingBadge}" />
        <Setter Property="CornerRadius" Value="{StaticResource UmCornerRadiusSmValue}" />
        <Setter Property="Background" Value="{ThemeResource LayerFillColorAltBrush}" />
    </Style>

    <Style x:Key="UmSemanticBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource UmPaddingBadge}" />
        <Setter Property="CornerRadius" Value="{StaticResource UmCornerRadiusSmValue}" />
    </Style>

    <Style x:Key="UmKanbanEmptyStateStyle" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource UmPaddingMd}" />
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource UmHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource UmCornerRadiusSmValue}" />
    </Style>
</ResourceDictionary>
