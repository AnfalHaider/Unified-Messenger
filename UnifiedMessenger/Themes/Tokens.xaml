<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme-aware brand tokens. UmBrandSlate is a near-black text colour on light, but must lighten on dark
         or section headers/badges vanish (they used to be a fixed #1E293B in both themes). Consumers MUST use
         {ThemeResource ...}, not {StaticResource ...}, for these to switch. High-contrast is handled by the
         runtime-merged Themes/HighContrast.xaml (see ThemeService). -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="UmBrandSlateColor">#1E293B</Color>
            <SolidColorBrush x:Key="UmBrandSlateBrush" Color="#1E293B" />
            <Color x:Key="UmBrandTealColor">#1B75BB</Color>
            <SolidColorBrush x:Key="UmBrandTealBrush" Color="#1B75BB" />

            <!--
                Semantic status, light theme. These are drawn as TEXT — the on-time percentage on the
                Analytics leaderboard picks one of the three by value — so the bar is 4.5:1, not 3:1.
                Measured on the white card they sit on:
                  success #22C55E -> 2.28:1  FAIL   now #15803D -> 5.02:1
                  warning #F59E0B -> 2.15:1  FAIL   now #B45309 -> 5.02:1
                  danger  #DC2626 -> 4.83:1  passes, kept
                They used to be a single value shared with the dark theme, which cannot work: a colour
                readable on near-black is not readable on white. Same lesson as UmBrandTealColor above,
                applied later to the colours that actually carry the status. See StatusContrastTests.
            -->
            <Color x:Key="UmStatusSuccessColor">#15803D</Color>
            <Color x:Key="UmStatusWarningColor">#B45309</Color>
            <Color x:Key="UmStatusDangerColor">#DC2626</Color>
            <SolidColorBrush x:Key="UmStatusSuccessBrush" Color="#15803D" />
            <SolidColorBrush x:Key="UmStatusWarningBrush" Color="#B45309" />
            <SolidColorBrush x:Key="UmStatusDangerBrush" Color="#DC2626" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="UmBrandSlateColor">#DCE3EC</Color>
            <SolidColorBrush x:Key="UmBrandSlateBrush" Color="#DCE3EC" />
            <!--
                Lighter on dark for the same reason UmBrandSlate is: the brand blue #1B75BB measures
                2.82:1 on a dark card, which fails even the 3:1 WCAG 1.4.11 bar for non-text UI — and it is
                used for the message-volume chart line and the empty-state icon, where being hard to see is
                the whole problem. #58A6FF measures 5.43:1 on a dark card and 6.6:1 on dark chrome.
                It also improves the accent button, whose dark-theme foreground is near-black:
                black on #1B75BB was 4.31:1 (a marginal fail), black on #58A6FF is 8.31:1.
            -->
            <Color x:Key="UmBrandTealColor">#58A6FF</Color>
            <SolidColorBrush x:Key="UmBrandTealBrush" Color="#58A6FF" />

            <!--
                Semantic status, dark theme. Success and warning were already fine here — it is DANGER
                that failed, at almost exactly the same ratio the brand blue did:
                  success #22C55E -> 6.03:1  passes, kept
                  warning #F59E0B -> 6.39:1  passes, kept
                  danger  #DC2626 -> 2.84:1  FAIL   now #F87171 -> 4.96:1 (6.03:1 on dark chrome)
                Declared here even where the value is unchanged, so both themes state all three
                explicitly and neither can silently inherit the other's palette again.
            -->
            <Color x:Key="UmStatusSuccessColor">#22C55E</Color>
            <Color x:Key="UmStatusWarningColor">#F59E0B</Color>
            <Color x:Key="UmStatusDangerColor">#F87171</Color>
            <SolidColorBrush x:Key="UmStatusSuccessBrush" Color="#22C55E" />
            <SolidColorBrush x:Key="UmStatusWarningBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="UmStatusDangerBrush" Color="#F87171" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Color x:Key="UmBrandBlueStartColor">#1B75BB</Color>
    <Color x:Key="UmBrandBlueEndColor">#2E3191</Color>
    <Color x:Key="UmBrandTealDarkColor">#2E3191</Color>
    <Color x:Key="UmBrandBlueColor">#1B75BB</Color>
    <Color x:Key="UmBrandVioletColor">#2E3191</Color>

    <SolidColorBrush x:Key="UmBrandBlueStartBrush" Color="{StaticResource UmBrandBlueStartColor}" />
    <SolidColorBrush x:Key="UmBrandBlueEndBrush" Color="{StaticResource UmBrandBlueEndColor}" />
    <!-- UmBrandTealBrush is defined per-theme above; do not redeclare it here or the theme switch is lost. -->
    <SolidColorBrush x:Key="UmBrandTealDarkBrush" Color="{StaticResource UmBrandTealDarkColor}" />
    <SolidColorBrush x:Key="UmBrandBlueBrush" Color="{StaticResource UmBrandBlueColor}" />
    <SolidColorBrush x:Key="UmBrandVioletBrush" Color="{StaticResource UmBrandVioletColor}" />

    <x:Double x:Key="UmSpacingXs">4</x:Double>
    <x:Double x:Key="UmSpacingSm">8</x:Double>
    <x:Double x:Key="UmSpacingMd">12</x:Double>
    <x:Double x:Key="UmSpacingLg">16</x:Double>
    <x:Double x:Key="UmSpacingXl">24</x:Double>
    <x:Double x:Key="UmCornerRadiusMd">8</x:Double>
    <x:Double x:Key="UmCornerRadiusSm">6</x:Double>

    <x:Double x:Key="UmFontSizeCaption">10</x:Double>
    <x:Double x:Key="UmFontSizeSectionLabel">11</x:Double>
    <x:Double x:Key="UmFontSizeBody">12</x:Double>
    <x:Double x:Key="UmFontSizeScope">14</x:Double>
    <x:Double x:Key="UmFontSizeMetricValue">20</x:Double>
    <!-- Redesign type ramp: fills the gap between body (12) and the old lone 20/22 metric size, so a card
         reads label → value → hero instead of "small dense text then one big jump". -->
    <x:Double x:Key="UmFontSizeSubtitle">15</x:Double>
    <x:Double x:Key="UmFontSizeMetricSm">18</x:Double>
    <x:Double x:Key="UmFontSizeMetric">24</x:Double>
    <x:Double x:Key="UmFontSizeHero">34</x:Double>
    <x:Double x:Key="UmChartHeight">110</x:Double>
    <x:Double x:Key="UmChartPlotHeight">96</x:Double>
    <x:Double x:Key="UmChartStrokeThickness">2.5</x:Double>
    <x:Double x:Key="UmBadgeFontSize">10</x:Double>
    <x:Double x:Key="UmIconSizeSm">14</x:Double>
    <x:Double x:Key="UmKanbanColumnMinHeight">120</x:Double>
    <x:Double x:Key="UmOpacityMuted">0.65</x:Double>
    <x:Double x:Key="UmOpacityHint">0.75</x:Double>
    <x:Double x:Key="UmOpacitySubtle">0.55</x:Double>

    <Thickness x:Key="UmPaddingMd">12</Thickness>
    <Thickness x:Key="UmMetricCardPadding">16</Thickness>
    <Thickness x:Key="UmMarginSectionHeader">4,14,4,6</Thickness>
    <Thickness x:Key="UmMarginSectionHeaderFirst">4,0,4,6</Thickness>
    <Thickness x:Key="UmMarginActiveAccountsHeader">4,8,4,4</Thickness>
    <Thickness x:Key="UmPaddingThreadCard">12,10,10,10</Thickness>
    <Thickness x:Key="UmPaddingThreadCardImmediate">14</Thickness>
    <Thickness x:Key="UmPaddingBadge">6,2,6,2</Thickness>
    <Thickness x:Key="UmPaddingKanbanColumn">4</Thickness>
    <Thickness x:Key="UmMarginBrandHeader">4,0,4,12</Thickness>
    <Thickness x:Key="UmMarginIconLabelGap">10,0,0,0</Thickness>
    <Thickness x:Key="UmMarginBadgeGap">8,0,0,0</Thickness>
    <Thickness x:Key="UmPaddingLg">16</Thickness>
    <Thickness x:Key="UmPaddingSm">8</Thickness>
    <Thickness x:Key="UmPaddingFooter">12,10,12,12</Thickness>
    <Thickness x:Key="UmPaddingSidebarMenu">8,12,8,8</Thickness>
    <Thickness x:Key="UmPaddingSidebarMenuCompact">6,12,6,8</Thickness>
    <Thickness x:Key="UmPaddingFooterCompact">8,10,8,12</Thickness>
    <Color x:Key="UmModalOverlayColor">#66000000</Color>
    <SolidColorBrush x:Key="UmModalOverlayBrush" Color="{StaticResource UmModalOverlayColor}" />
    <SolidColorBrush x:Key="UmTransparentBrush" Color="#00000000" />
    <Thickness x:Key="UmPaddingBottomSm">0,0,0,8</Thickness>
    <Thickness x:Key="UmPaddingBottomXl">0,0,0,24</Thickness>
    <Thickness x:Key="UmMarginBottomSm">0,0,0,8</Thickness>
    <CornerRadius x:Key="UmCornerRadiusMdValue">8</CornerRadius>
    <CornerRadius x:Key="UmCornerRadiusSmValue">6</CornerRadius>
    <CornerRadius x:Key="UmCornerRadiusXsValue">2</CornerRadius>

    <!-- Semantic status (light theme defaults) -->
    <!-- UmStatusSuccess/Warning/DangerColor are defined per-theme above; do not redeclare them here or
         the theme switch is lost (the same trap the UmBrandTealBrush comment below records). -->
    <Color x:Key="UmStatusNeutralColor">#64748B</Color>
    <Color x:Key="UmStatusMutedColor">#94A3B8</Color>
    <Color x:Key="UmStatusReadColor">#2563EB</Color>
    <Color x:Key="UmStatusDeliveredColor">#64748B</Color>
    <Color x:Key="UmStatusSentColor">#94A3B8</Color>
    <Color x:Key="UmStatusPendingColor">#94A3B8</Color>

    <!-- UmStatusSuccess/Warning/DangerBrush are defined per-theme above alongside their colours. A
         StaticResource lookup out here cannot see inside a theme dictionary, so leaving them at the top
         level would either fail to resolve or pin one theme's palette for both. -->

    <SolidColorBrush x:Key="UmStatusNeutralBrush" Color="{StaticResource UmStatusNeutralColor}" />
    <SolidColorBrush x:Key="UmStatusMutedBrush" Color="{StaticResource UmStatusMutedColor}" />
    <SolidColorBrush x:Key="UmStatusReadBrush" Color="{StaticResource UmStatusReadColor}" />
    <SolidColorBrush x:Key="UmStatusDeliveredBrush" Color="{StaticResource UmStatusDeliveredColor}" />
    <SolidColorBrush x:Key="UmStatusSentBrush" Color="{StaticResource UmStatusSentColor}" />
    <SolidColorBrush x:Key="UmStatusPendingBrush" Color="{StaticResource UmStatusPendingColor}" />

    <!-- Layout tokens (DIPs) -->
    <x:Double x:Key="UmMetricCardWidth">180</x:Double>
    <x:Double x:Key="UmMetricCardMinWidth">140</x:Double>
    <x:Double x:Key="UmDatePickerMinWidth">140</x:Double>
    <x:Double x:Key="UmChartMinWidth">200</x:Double>
    <x:Double x:Key="UmChipMaxWidth">96</x:Double>
    <x:Double x:Key="UmKanbanColumnMinWidth">240</x:Double>
    <x:Double x:Key="UmKanbanBoardMinWidth">720</x:Double>
    <x:Double x:Key="UmCornerRadiusXs">2</x:Double>
    <x:Double x:Key="UmEmptyStateMaxWidth">420</x:Double>

    <Thickness x:Key="UmFilterChipPadding">10,4</Thickness>
    <Thickness x:Key="UmAiChipPadding">8,2</Thickness>
</ResourceDictionary>
