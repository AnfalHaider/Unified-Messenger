{
  "name": "unified-messenger-v6",
  "version": "6.0.1",
  "private": true,
  "description": "Unified Messenger: the app. Electron + TypeScript; the WinUI 3 / .NET versions were retired on 2026-09-20.",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "start": "vite build && electron app/main.ts",
    "smoke": "vite build && playwright test",
    "build:ui": "vite build",
    "ui": "vite",
    "dev": "electron app/main.ts",
    "dist": "node scripts/dist.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "install-local": "node scripts/dist.mjs --install",
    "help:shots": "node scripts/help-shots.mjs",
    "assistant:test": "node scripts/assistant-eval.ts",
    "rules:test": "node scripts/rules-run.mjs",
    "cloud:deploy": "firebase deploy --only firestore --project unified-messenger-5549a",
    "site:deploy": "firebase deploy --only hosting --project unified-messenger-5549a"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electron/fuses": "^2.1.3",
    "@electron/packager": "^20.3.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.30.2",
    "typescript": "7.0.2",
    "vite": "^8.3.0"
  },
  "main": "app/main.ts",
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "productName": "Unified Messenger"
}
