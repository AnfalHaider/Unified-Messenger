{
  "name": "unified-messenger-v6",
  "version": "6.0.0",
  "private": true,
  "description": "Unified Messenger v6: Electron + TypeScript rebuild. v5 (UnifiedMessenger/) keeps shipping until parity.",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "start": "vite build && electron app/main.ts",
    "smoke": "electron app/main.ts",
    "build:ui": "vite build",
    "ui": "vite",
    "dev": "electron app/main.ts",
    "dist": "node scripts/dist.mjs",
    "install-local": "node scripts/dist.mjs --install"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "typescript": "7.0.2",
    "vite": "^8.3.0"
  },
  "main": "app/main.ts",
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "productName": "Unified Messenger"
}
